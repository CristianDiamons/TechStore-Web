@model List<TechStoreMVC.Models.Producto>

@{
    ViewData["Title"] = "Administrar productos";
}

<div class="admin-productos">

    <div class="admin-encabezado">
        <div>
            <h1>Administrar productos</h1>
            <p>Gestiona el catálogo de TechStore.</p>
        </div>

        <a asp-controller="Productos"
           asp-action="Create"
           class="admin-boton-principal">
            + Agregar producto
        </a>
    </div>

    @if (TempData["Mensaje"] != null)
    {
        <div class="admin-mensaje">
            @TempData["Mensaje"]
        </div>
    }

    <div class="admin-resumen">
        <div class="admin-resumen-tarjeta">
            <span>Total de productos</span>
            <strong>@Model.Count</strong>
        </div>
    </div>

    <div class="admin-tabla-contenedor">

        <table class="admin-tabla">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Producto</th>
                    <th>Categoría</th>
                    <th>Precio</th>
                    <th>Acciones</th>
                </tr>
            </thead>

            <tbody>
                @if (Model.Any())
                {
                    @foreach (var producto in Model)
                    {
                        <tr>
                            <td>@producto.IdProducto</td>

                            <td>
                                <div class="admin-producto-info">
                                    @if (!string.IsNullOrEmpty(producto.Imagen))
                                    {
                                        <img src="@Url.Content("~/images/" + producto.Imagen)"
                                             alt="@producto.Nombre" />
                                    }
                                    else
                                    {
                                        <span class="admin-icono-producto">
                                            @(string.IsNullOrEmpty(producto.Icono)
                                                ? "📦"
                                                : producto.Icono)
                                        </span>
                                    }

                                    <span>@producto.Nombre</span>
                                </div>
                            </td>

                            <td>@producto.Categoria</td>

                            <td class="admin-precio">
                                @producto.Precio.ToString("C2")
                            </td>

                            <td>
                                <div class="admin-acciones">

                                    <a asp-action="Details"
                                       asp-route-id="@producto.IdProducto"
                                       class="admin-accion ver">
                                        Ver
                                    </a>

                                    <a asp-action="Edit"
                                       asp-route-id="@producto.IdProducto"
                                       class="admin-accion editar">
                                        Editar
                                    </a>

                                    <a asp-action="Delete"
                                       asp-route-id="@producto.IdProducto"
                                       class="admin-accion eliminar">
                                        Eliminar
                                    </a>

                                </div>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="5" class="admin-sin-productos">
                            No hay productos registrados.
                        </td>
                    </tr>
                }
            </tbody>
        </table>

    </div>

    <div class="admin-regresar">
        <a asp-controller="Home" asp-action="Index">
            ← Volver a la tienda
        </a>
    </div>

</div>
